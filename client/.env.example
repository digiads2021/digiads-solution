# Leave empty: in development Vite proxies /api to localhost:5000, and on Vercel the API
# is served from the same domain. Only set it if the API is hosted on a different domain.
VITE_API_URL=

# Public site URL, used for canonical links and structured data
VITE_SITE_URL=http://localhost:5173

# Base URL for relative image paths. Leave empty (production images are full Cloudinary/Blob URLs).
VITE_ASSET_URL=
