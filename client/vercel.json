{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://digiads-solution-api.vercel.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://digiads-solution-api.vercel.app/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://digiads-solution-api.vercel.app/sitemap.xml" },
    { "source": "/((?!assets/|favicon.svg|robots.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
