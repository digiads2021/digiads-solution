# ---------- Server ----------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digiads?retryWrites=true&w=majority

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend URL(s) allowed by CORS (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# Public site URL (used in sitemap.xml)
SITE_URL=http://localhost:5173

# Cookie settings: "lax" when site and API share a domain (digiadssolution.in + api.digiadssolution.in)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------- First admin (used by: npm run create-admin) ----------
ADMIN_NAME=DigiAds Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# ---------- Optional: email alerts for new enquiries ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ENQUIRY_NOTIFY_EMAIL=

# ---------- Image uploads (production) ----------
# Cloudinary (recommended). Copy "API environment variable" from Cloudinary > Settings > API Keys.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=digiads
# Or Vercel Blob (used only when Cloudinary is not set). Added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=
