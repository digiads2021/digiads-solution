# Leave empty in development (Vite proxies /api to localhost:5000).
# In production set it to your API domain, e.g. https://api.digiadssolution.in/api
VITE_API_URL=

# Public site URL, used for canonical links and structured data
VITE_SITE_URL=http://localhost:5173

# Base URL for uploaded images. Empty in development; in production e.g. https://api.digiadssolution.in
VITE_ASSET_URL=
